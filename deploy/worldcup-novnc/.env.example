# Copy this file to deploy/worldcup-novnc/.env and adjust values.

# noVNC published port on host
WORLDCUP_WEB_PORT=6080

# Internal ports (usually keep defaults)
NOVNC_PORT=6080
VNC_PORT=5900

# Optional: auto login without tkinter credential popup.
# Leave empty to keep the original credential dialogs.
WORLDCUP_DB_USER=worldcup
WORLDCUP_DB_PASSWORD=worldcup
WORLDCUP_DB_NAME=coupe_du_monde
WORLDCUP_DB_HOST=db
WORLDCUP_DB_PORT=5432

# Link shown inside noVNC to return to your portfolio
PORTFOLIO_URL=http://localhost:5173/

# PostgreSQL sidecar credentials
POSTGRES_USER=worldcup
POSTGRES_PASSWORD=worldcup
POSTGRES_DB=postgres

